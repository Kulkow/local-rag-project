POSTGRES_USER=rag
POSTGRES_DB=rag
# Set distinct random values; URL-safe characters for POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Use the Ollama installation on the host (Docker Desktop on macOS).
OLLAMA_URL=http://host.docker.internal:11434
# Models found in the local Ollama model store.
CHAT_MODEL=qwen3:4b
EMBEDDING_MODEL=embeddinggemma:latest
# Ingestion validates actual embedding dimensions against EMBEDDING_DIMENSIONS.
# CPU baseline: 16 GB RAM, 20 GB free disk.

# ADMIN_USERNAME/ADMIN_PASSWORD also seed the DB admin only via make bootstrap-admin.
# Username: 3-100 lowercase ASCII letters/digits/_.@-; password: 12-128 characters.
# Editing these later does not change the stored DB password; use Users management.

# JWT HS256 signing key: generate a distinct random value of at least 32 characters.
# Docker-only generation: docker run --rm python:3.12.8-slim python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Original RAG uploads. Docker local maps existing MinIO root credentials to API.
# For external environments use separate bucket-scoped MINIO_ACCESS_KEY/SECRET_KEY.
DOCUMENTS_BUCKET=rag-documents

# Optional API-only bucket credentials; empty values fall back to root for local use.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Optional monitoring profile: http://localhost:3001, provisioned queue dashboard.
# Empty values reuse explicit ADMIN_USERNAME/ADMIN_PASSWORD for local bootstrap.
# Prefer a separate Grafana password; changing env does not rotate an existing Grafana user.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Verified locally against embeddinggemma:latest /api/embed: 768-dimensional vectors.
# Recreate API/worker after edits; explicitly reindex documents after model/chunker changes.
EMBEDDING_DIMENSIONS=768
# Character windows, per normalized page; these are not token counts.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=8
MAX_DOCUMENT_CHUNKS=2000

# Vector cosine threshold: initial operating default, not a calibrated quality gate.
# Keyword ts_rank scores are separate and are not compared to this threshold.
RAG_MIN_VECTOR_SCORE=0.35
