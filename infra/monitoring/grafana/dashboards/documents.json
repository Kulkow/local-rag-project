{
  "uid": "document-processing",
  "title": "Document Processing Queue",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Задания по состоянию",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rag-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rag_document_jobs",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Worker heartbeat (1 = жив)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "rag-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
