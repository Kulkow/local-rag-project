{
  "uid": "rag-performance",
  "title": "RAG Performance",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Время RAG — p50",
      "type": "timeseries",
      "description": "Время admitted application-вызовов без ожидания слота. Бакетная оценка; на малой выборке не является бенчмарком.",
      "datasource": {
        "type": "prometheus",
        "uid": "rag-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, mode, operation) (rate(rag_request_duration_seconds_bucket{outcome!~\"error|cancelled\"}[5m])))",
          "legendFormat": "{{mode}} / {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Время RAG — p95",
      "type": "timeseries",
      "description": "Время admitted application-вызовов без ожидания слота. Бакетная оценка; на малой выборке не является бенчмарком.",
      "datasource": {
        "type": "prometheus",
