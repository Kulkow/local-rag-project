        }
      }
    },
    {
      "id": 3,
      "title": "Этапы RAG — p50",
      "type": "timeseries",
      "description": "retrieval включает scope/embedding/search/context. Этапы вложены, их нельзя суммировать. ACL и embedding_identity могут вызываться дважды.",
      "datasource": {
        "type": "prometheus",
        "uid": "rag-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, stage, mode) (rate(rag_stage_duration_seconds_bucket{outcome=\"success\"}[5m])))",
          "legendFormat": "{{stage}} / {{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
